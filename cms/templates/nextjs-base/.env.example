# Server-only CMS credentials. Never prefix CMS_READ_KEY or CMS_PREVIEW_KEY with NEXT_PUBLIC_.
CMS_API_URL=http://localhost:4000
CMS_SITE_SLUG=your-site-slug
CMS_READ_KEY=your-site-read-key
CMS_PREVIEW_KEY=your-site-preview-key

# Must match REVALIDATE_SECRET in the CMS API environment.
REVALIDATE_SECRET=replace_with_the_same_long_random_secret_as_the_api

# Public values used by the browser contact form.
NEXT_PUBLIC_CMS_API_URL=http://localhost:4000
NEXT_PUBLIC_CMS_SITE_SLUG=your-site-slug
