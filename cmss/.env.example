# PostgreSQL connection used by Prisma and Better Auth
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:ashu%40123@localhost:5432/cms-builder"
BETTER_AUTH_SECRET=7aa2e394a6a8d9c5621d8e8bb80fb77dfb3f3d1112246e72896c50cf274f9945
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# S3-compatible object storage (required for media uploads)
S3_REGION="us-east-1"
S3_BUCKET="cms-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Leave empty for AWS S3; set for MinIO, Cloudflare R2, etc.
S3_ENDPOINT=""
# Optional public base URL. When empty, media is streamed through this app.
S3_PUBLIC_URL=""

# DNS target used when configuring customer domains
PLATFORM_CNAME_TARGET=""
NEXT_PUBLIC_PLATFORM_CNAME=""
